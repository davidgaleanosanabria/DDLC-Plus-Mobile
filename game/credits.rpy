label credits:
    $ persistent.autoload = "credits"
    $ renpy.save_persistent()
    $ config.keymap['game_menu'] = []
    $ config.keymap['hide_windows'] = []
    $ renpy.display.behavior.clear_keymap_cache()
    $ quick_menu = False
    $ config.skipping = False
    $ config.allow_skipping = False
    scene black
    play music "bgm/end-voice.ogg" noloop

    show noise zorder 9:
        alpha 0.0
        linear 1.5 alpha 1.0
        time 2.0
        parallel:
            0.05
            choice:
                alpha 0.5
            choice:
                alpha 0.75
            choice:
                alpha 1.0
            repeat
        parallel:
            linear 0.375 alpha 0.7
            linear 0.375 alpha 1.0
        time 2.75
        alpha 0.95
        time 6.45
        alpha 0.3
        time 6.95
        alpha 0.9
        time 8.65
        linear 0.8 alpha 0
        alpha 0.5
        time 22.1
        alpha 0.85
        time 22.35
        alpha 0.5
        time 28.20
        alpha 0.3
        linear 0.45 alpha 0.9
        alpha 0.4
    show vignette zorder 10:
        alpha 0.75
        parallel:
            0.36
            alpha 0.75
            repeat
        parallel:
            0.49
            alpha 0.7
            repeat
    show end_glitch1 zorder 2
    show black as bar zorder 9:
        alpha 0.3
        size (1280,500)
        block:
            ypos 720
            linear 15 ypos -500
            repeat

    pause 9
    show end_voice_subtitle1 as subtitleImage zorder 100
    pause 4
    show end_voice_subtitle2 as subtitleImage zorder 100
    pause 3
    show end_voice_subtitle3 as subtitleImage zorder 100
    pause 6
    show end_voice_subtitle4 as subtitleImage zorder 100
    pause 5
    show end_voice_subtitle5 as subtitleImage zorder 100
    pause 2
    show end_voice_subtitle6 as subtitleImage zorder 100
    pause 3
    show end_voice_subtitle7 as subtitleImage zorder 100
    pause 4
    show end_voice_subtitle8 as subtitleImage zorder 100
    pause 2
    hide subtitleImage


    label credits_JUMP:
        pause 3
        scene black
        pause 0.5
        $ consolehistory = []
        call updateconsole ("renpy.music.play(\"ddlc.ogg\")", "Playing audio \"ddlc.ogg\"...")
        pause 1.0
        call hideconsole
        play music "<to 50.0>bgm/credits.ogg" noloop
        $ unlock("bgm_yourreality")
        show mcredits_1a zorder 50
        show mcredits_1b zorder 49
        show mcredits_1c zorder 48
        show mcredits_2a zorder 47
        show mcredits_2b zorder 46
        show mcredits_2c zorder 45
        show mcredits_3 zorder 44
        show mcredits_4 zorder 43
        show mcredits_5 zorder 42
        show mcredits_6a zorder 41
        show mcredits_6b zorder 40
        show mcredits_7 zorder 51

        pause 50
        jump credits2

