screen poem(currentpoem, paper="paper", first_poem=False, gallery=False, gallery_width=None):

    style_prefix "poem"





    $ poem_text_style = "monika_text"
    $ poem_text_size = alt_text_size
    $ paper_width = 720

    if persistent.use_alt_poem_font and not currentpoem.yuri_3:
        $ paper_width = get_relative_size(paper_width, alt_text_size, max_alt_text_size)
        $ poem_text_size = get_variable_size(alt_text_size, max_alt_text_size)
        $ poem_text_style = "alt_poem_text"
    else:
        $ poem_text_style = currentpoem.author + "_text"
        if currentpoem.author == "yuri":
            if currentpoem.yuri_3:
                $ poem_text_style = "yuri_text_3"
            else:
                $ paper_width = get_relative_size(paper_width, yuri_text_size, max_yuri_text_size)
                $ poem_text_size = get_variable_size(yuri_text_size, max_yuri_text_size)
        elif currentpoem.author == "sayori":
            $ paper_width = get_relative_size(paper_width, sayori_text_size, max_sayori_text_size)
            $ poem_text_size = get_variable_size(sayori_text_size, max_sayori_text_size)
        elif currentpoem.author == "natsuki":
            $ paper_width = get_relative_size(paper_width, natsuki_text_size, max_natsuki_text_size)
            $ poem_text_size = get_variable_size(natsuki_text_size, max_natsuki_text_size)
        elif currentpoem.author == "monika":
            $ paper_width = get_relative_size(paper_width, monika_text_size, max_monika_text_size)
            $ poem_text_size = get_variable_size(monika_text_size, max_monika_text_size)

    if gallery:
        $ poem_text_size = poem_text_size * (720 / gallery_width)




    frame:
        modal True
        xalign 0.5
        xsize (round(800 * (paper_width / 720)) / 1280)
        xpadding round(40 * (paper_width / 720))
        ypadding 0
        background Frame(paper)


        viewport id "vp":
            mousewheel True
            draggable True
            has vbox
            xalign 0.5
            null height (40 if currentpoem.title != "" else 1)

            text (("[currentpoem.title!t]\n\n" if currentpoem.title != "" else "") + "[currentpoem.text!t]") style poem_text_style size poem_text_size
            if currentpoem.extra_text != "":
                null height 20
                add "gui/long_divider_dark.png" xsize 0.85 fit "scale-down" xalign 0.5
                null height 20
                text ("[currentpoem.extra_text!t]") style poem_text_style text_align 1.0 size poem_text_size xalign 1.0
            else:
                null height 100
        if gallery == False:
            vbar value YScrollValue(viewport="vp") style "poem_vbar"
    if first_poem:
        add "gui/poem_dismiss.png":
            xanchor 1.0
            yanchor 1.0
            xpos 0.98
            ypos 0.98


