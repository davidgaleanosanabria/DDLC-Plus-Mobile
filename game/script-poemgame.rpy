    full_wordlist = []
    with renpy.file('poemwords.txt') as wordfile: 
        for line in wordfile:
            
            line = line.decode("utf-8").strip() 
            
            if line == '' or line[0] == '#': continue
            
            
            x = line.split(',')
            full_wordlist.append(PoemWord(x[0], float(x[1]), float(x[2]), float(x[3])))

