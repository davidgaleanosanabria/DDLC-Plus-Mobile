screen poemgame_word_container(words=[], current_progress=1, max_words=20):

    default progress_string = str(current_progress) + "/" + str(max_words)


    python:
        if persistent.playthrough == 2 and chapter == 2:
            pstring = ""
            for i in range(current_progress):
                pstring += str("1")
            progress_string = pstring + "/" + str(max_words)

    text progress_string:
        style "poemgame_text"
        pos (810, 80)

    grid 2 5:
        pos (440, 145)
        yspacing 28
        xspacing 10
        for word in words:
            button:
                style "poemgame_button"
                xsize 220
                action Return(word)
                text word.word:
                    style "poemgame_text"
                    layout "nobreak"
                    at (loc_text_fit if not word.glitch else None)
return
